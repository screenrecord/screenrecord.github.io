---
import { languages } from '../i18n/ui';

const currentLang = Astro.currentLocale || 'en';
---

<div class="relative inline-block text-left">
  <select
    onchange="window.location.pathname = this.value"
    class="block w-full appearance-none rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 pr-8 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-rose-500 cursor-pointer transition-colors"
    aria-label="Select Language"
  >
    {Object.entries(languages).map(([lang, label]) => (
      <option value={lang === 'en' ? '/' : `/${lang}/`} selected={currentLang === lang}>
        {label}
      </option>
    ))}
  </select>
  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500 dark:text-slate-400">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
  </div>
</div>
