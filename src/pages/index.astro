---
import Layout from '../layouts/Layout.astro';
import ScreenRecorder from '../components/ScreenRecorder';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "ScreenRecord Web Tool",
    "applicationCategory": "MultimediaApplication, VideoEditingApplication",
    "operatingSystem": "Any (Web Browser with MediaRecorder API)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is this screen recorder really free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our screen recorder is 100% free to use. There are no hidden fees, no subscriptions, and no premium features locked behind a paywall."
        }
      },
      {
        "@type": "Question",
        "name": "Is my video uploaded to your servers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, your privacy is our top priority. All recording and processing happens entirely within your web browser. Your video files are never uploaded to our servers or any cloud storage."
        }
      },
      {
        "@type": "Question",
        "name": "Are there any time limits or watermarks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, there are no artificial time limits and we do not add any watermarks to your recordings. You can record for as long as your device's memory allows."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to install any software or extensions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not at all! Our tool is entirely web-based. It uses modern browser APIs to capture your screen and audio, so no downloads, plugins, or extensions are required."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://screenrecord.github.io/"
      }
    ]
  }
];

const faqs = [
  {
    q: "Is this screen recorder really free?",
    a: "Yes, our screen recorder is 100% free to use. There are no hidden fees, no subscriptions, and no premium features locked behind a paywall."
  },
  {
    q: "Is my video uploaded to your servers?",
    a: "No, your privacy is our top priority. All recording and processing happens entirely within your web browser. Your video files are never uploaded to our servers or any cloud storage."
  },
  {
    q: "Are there any time limits or watermarks?",
    a: "No, there are no artificial time limits and we do not add any watermarks to your recordings. You can record for as long as your device's memory allows."
  },
  {
    q: "Do I need to install any software or extensions?",
    a: "Not at all! Our tool is entirely web-based. It uses modern browser APIs to capture your screen and audio, so no downloads, plugins, or extensions are required."
  }
];
---

<Layout 
  title="Free Online Screen Recorder | Record Screen, Webcam & Audio Privately"
  description="Free web-based screen recorder without watermark or download. Record screen, tab, webcam, and microphone directly in your browser. 100% private and secure."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <section class="py-16 md:py-24 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight mb-6">
        Free Online Screen Recorder
      </h1>
      <p class="text-lg md:text-xl text-slate-600 mb-10 max-w-2xl mx-auto">
        Record your screen, webcam, and microphone directly in your browser. Zero installation, zero watermarks, and 100% private.
      </p>
      
      <ScreenRecorder client:load />
    </div>
  </section>

  <section class="py-16 bg-white border-t border-slate-100">
    <div class="max-w-4xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12">
        
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">How to Record Your Screen Online</h2>
          <ol class="space-y-4">
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center font-bold">1</span>
              <p class="text-slate-600 pt-1">Choose your recording mode (Screen, Screen + Mic, Webcam, or Audio).</p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center font-bold">2</span>
              <p class="text-slate-600 pt-1">Click 'Start Recording' and select the screen, application window, or browser tab.</p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center font-bold">3</span>
              <p class="text-slate-600 pt-1">Perform your task, demo, or tutorial with real-time timer tracking.</p>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center font-bold">4</span>
              <p class="text-slate-600 pt-1">Click 'Stop Recording' to preview and instantly download your video file.</p>
            </li>
          </ol>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Why Use Our In-Browser Screen Recorder?</h2>
          <ul class="space-y-4">
            <li class="flex gap-3">
              <svg aria-hidden="true" class="w-6 h-6 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <div>
                <strong class="block text-slate-900">Zero Installation</strong>
                <p class="text-slate-600 text-sm">No bulky desktop apps, browser extensions, or plugins required.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <svg aria-hidden="true" class="w-6 h-6 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <div>
                <strong class="block text-slate-900">Complete Privacy</strong>
                <p class="text-slate-600 text-sm">Video streams are processed purely in client memory and never uploaded to cloud servers.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <svg aria-hidden="true" class="w-6 h-6 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <div>
                <strong class="block text-slate-900">No Watermarks or Time Limits</strong>
                <p class="text-slate-600 text-sm">Record cleanly without branded watermarks or artificial restrictions.</p>
              </div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-slate-900 mb-10">Frequently Asked Questions</h2>
      <div class="space-y-6">
        {faqs.map(faq => (
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{faq.q}</h3>
            <p class="text-slate-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
